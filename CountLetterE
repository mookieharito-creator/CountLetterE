Algorithme AnalysePhrase

Variables
    ch : Caractère
    longueur : Entier
    nb_mots : Entier
    nb_voyelles : Entier

Début
    // Initialisation des trois compteurs à 0
    longueur ← 0
    nb_mots ← 0
    nb_voyelles ← 0

    Écrire("Entrez une phrase caractère par caractère, se terminant par un point (.) :")
    Lire(ch)

    // Si le premier caractère n'est pas le point, la phrase contient au moins un mot
    Si ch ≠ '.' Alors
        nb_mots ← 1
    FinSi

    // Boucle jusqu'à l'atteinte du point final
    Tant que ch ≠ '.' Faire
        
        // 1. Incrémenter la longueur pour chaque caractère (le point est exclu car hors de la boucle)
        longueur ← longueur + 1

        // 2. Vérifier si le caractère est une voyelle (minuscules et majuscules)
        Si ch = 'a' ou ch = 'e' ou ch = 'i' ou ch = 'o' ou ch = 'u' ou ch = 'y' ou 
           ch = 'A' ou ch = 'E' ou ch = 'I' ou ch = 'O' ou ch = 'U' ou ch = 'Y' Alors
            nb_voyelles ← nb_voyelles + 1
        FinSi

        // 3. Compter les mots (chaque espace indique qu'un nouveau mot commence)
        Si ch = ' ' Alors
            nb_mots ← nb_mots + 1
        FinSi

        Lire(ch)  // Lire le caractère suivant
    FinTantque

    // Afficher les résultats finaux demandés
    Écrire("Longueur de la phrase : ", longueur)
    Écrire("Nombre de mots : ", nb_mots)
    Écrire("Nombre de voyelles : ", nb_voyelles)

Fin
